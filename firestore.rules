rules_version = '2';

// Paste these into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Accounts are made only in the Firebase console (public sign-up is off).
    // taster@<project>.firebaseapp.com holds the site's shared password; any other account is Badriyah.
    function isSignedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function isTaster() {
      return isSignedIn() && request.auth.token.email.matches('taster@.*');
    }
    function isAdmin() {
      return isSignedIn() && !isTaster();
    }

    // A coffee the taster adds himself: his café, order and beans plus his rating, in one go.
    function isOwnCoffee() {
      let d = request.resource.data;
      return d.keys().hasOnly(['cafe', 'date', 'order', 'beans', 'own', 'rating', 'heart', 'comment', 'notes', 'createdAt', 'ratedAt'])
        && d.own == true
        && d.cafe is string && d.cafe.size() > 0 && d.cafe.size() <= 120
        && d.order is string && d.order.size() > 0 && d.order.size() <= 160
        && d.beans is string && d.beans.size() <= 160
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.rating is int && d.rating >= 1 && d.rating <= 5
        && d.heart is bool && (d.heart == false || d.rating == 5)
        && d.comment is string && d.comment.size() <= 1000
        && d.notes is string && d.notes.size() <= 1000
        && d.createdAt == request.time && d.ratedAt == request.time;
    }

    match /coffees/{id} {
      allow read: if isSignedIn();
      allow create: if (isAdmin()
        && request.resource.data.keys().hasOnly(['cafe', 'date', 'order', 'beans', 'description', 'question', 'createdAt']))
        || (isSignedIn() && isOwnCoffee());
      allow delete: if isAdmin();

      // Badriyah can change anything. The taster can only add the rating, comment and notes, once.
      allow update: if isAdmin() || (isSignedIn()
        && !('rating' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'heart', 'comment', 'notes', 'ratedAt'])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.heart is bool
        && (request.resource.data.heart == false || request.resource.data.rating == 5)
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 1000
        && request.resource.data.ratedAt == request.time
      );
    }
  }
}
